{
  "expo": {
    "name": "Hexa POS Nexus",
    "slug": "hexa-pos-nexus-mobile",
    "version": "0.0.1",
    "entry": "./index.js",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.hexaTech.hexapos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "We use your location to verify check-in at your branch."
      }
    },
    "android": {
      "package": "com.hexaTech.hexapos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1f2e"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "sdkVersion": "54.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "We use your location to verify you are at the branch when you check in.",
          "locationWhenInUsePermission": "We use your location to verify check-in at your branch."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "6e880ab1-a653-428f-8ba5-0df75dd02e64"
      }
    },
    "experiments": {
      "baseUrl": ""
    }
  }
}
